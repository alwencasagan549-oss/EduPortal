# ----------------------------------------------------------------------
# EDUPORTAL LMS - CORE ROUTING & SECURITY
# Optimized for InfinityFree / MariaDB / Apache
# ----------------------------------------------------------------------

# Disable Directory Listings
Options -Indexes

# Set Index Page
DirectoryIndex index.php

# Block access to sensitive and hidden files
<FilesMatch "(\.(sql|bak|inc|cfg|config|log|env|php\..*|.*~$|.*\.swp|.*\.bak|.*\.old)|^\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Custom error pages (optional)
# ErrorDocument 404 /assignment_portal/404.html
# ErrorDocument 500 /assignment_portal/500.html

# Basic rewrite rules
RewriteEngine On

# Remove trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# Protect the config directory
RewriteRule ^config/ - [F,L]

# Redirect to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set Referrer-Policy strict-origin-when-cross-origin
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>