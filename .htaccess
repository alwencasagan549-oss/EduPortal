# ----------------------------------------------------------------------
# EDUPORTAL LMS - CORE ROUTING & SECURITY
# Optimized for InfinityFree / MariaDB / Apache
# ----------------------------------------------------------------------

# Disable Directory Listings
Options -Indexes

# Set Index Page
DirectoryIndex index.php

# Allow Let's Encrypt SSL challenge files
<LocationMatch "^/\.well-known/acme-challenge/.*">
    Require all granted
</LocationMatch>

# Block access to sensitive and hidden files
<FilesMatch "(\.(sql|bak|inc|cfg|config|log|env|php\..*|.*~$|.*\.swp|.*\.bak|.*\.old)|^\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Custom error pages (optional)
# ErrorDocument 404 /assignment_portal/404.html
# ErrorDocument 500 /assignment_portal/500.html

# Basic rewrite rules
RewriteEngine On

# Remove trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# Protect the config directory
RewriteRule ^config/ - [F,L]

RewriteRule ^uploads(?:/|$) - [F,L]

# Redirect to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set Referrer-Policy strict-origin-when-cross-origin
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-site"
    Header always unset X-Powered-By
    Header append Vary Accept-Encoding
    <Files "manifest.webmanifest">
        Header set Content-Type "application/manifest+json"
    </Files>
    <Files "sw.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
    <FilesMatch "\.(css|js|svg|woff2|png|jpg|jpeg|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>
    <Files "sw.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css application/javascript text/javascript application/json image/svg+xml application/manifest+json
</IfModule>