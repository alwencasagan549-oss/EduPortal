# ----------------------------------------------------------------------
# EDUPORTAL LMS - CORE ROUTING & SECURITY
# Optimized for InfinityFree / MariaDB / Apache
# ----------------------------------------------------------------------

# Disable Directory Listings
Options -Indexes

# Set Index Page
DirectoryIndex index.php

# NOTE: the Let's Encrypt ACME challenge exemption lives in pwa-apache.conf,
# not here. <LocationMatch> is only valid in the main server config, never in
# .htaccess; Apache treats it as a syntax error and answers every request with
# a 500. That is why this file must not contain any <Location*> or
# <Directory*> sections.

# Block access to sensitive and hidden files
<FilesMatch "(\.(sql|bak|inc|cfg|config|log|env|php\..*|.*~$|.*\.swp|.*\.bak|.*\.old)|^\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Custom error pages (optional)
# ErrorDocument 404 /assignment_portal/404.html
# ErrorDocument 500 /assignment_portal/500.html

# Basic rewrite rules
RewriteEngine On

# Remove trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# Protect directories that hold secrets or user documents.
# (The Docker image enforces the same rules in pwa-apache.conf, so they hold
#  even if this file is missing from a build context.)
RewriteRule ^config(?:/|$) - [F,L]
RewriteRule ^data(?:/|$) - [F,L]
RewriteRule ^migrations(?:/|$) - [F,L]
RewriteRule ^uploads(?:/|$) - [F,L]

# Canonical host + HTTPS.
# %{HTTP_HOST} is taken from the client's Host header, so using it in a
# redirect target let any caller mint a 301 to an attacker-controlled host
# (open redirect + cache poisoning). Pin the canonical name instead.
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{SERVER_NAME}/$1 [R=301,L]

# Security Headers
AddType image/avif .avif

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set Referrer-Policy strict-origin-when-cross-origin
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), publickey-credentials-get=(self)"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-site"
    Header always unset X-Powered-By
    Header append Vary Accept-Encoding
    <Files "manifest.webmanifest">
        Header set Content-Type "application/manifest+json"
    </Files>
    <Files "sw.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
    <FilesMatch "\.(css|js|svg|woff2|png|jpg|jpeg|gif|webp|avif|ico)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>
    <Files "sw.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css application/javascript text/javascript application/json image/svg+xml application/manifest+json
</IfModule>