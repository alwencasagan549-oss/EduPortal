# NOTE ON .htaccess
#
# It is deliberately NOT shipped in the image. Security for the container comes
# from pwa-apache.conf, which is real server-level config: it denies config/,
# data/, migrations/, uploads/ and .sql the same way. Shipping a duplicate of
# those rules in a per-directory .htaccess added a fragile second layer that can
# fail closed on every single request if it ever contains a directive Apache
# rejects in that context. A server-level config error fails the build loudly
# instead.
#
# The root .htaccess is still used by non-Docker Apache hosts (XAMPP,
# shared hosting); it is just not part of the production image.
.htaccess
uploads/.htaccess

# Dependencies are installed inside the image
node_modules
vendor

# Version control and agent state
.git
.kilo

# Uploaded student documents must never be baked into an image layer
uploads

# Secrets
config/credentials.php
.env
.env.*

# Development-only seed data (contains published passwords)
data/dev_seed.sql

# Local env junk
*.log
.idea
.vscode
