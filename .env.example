# EduPortal Environment Configuration
#
# Copy this file to config/credentials.php for local development, or set these
# as real environment variables in production. config/credentials.php is
# gitignored and excluded from the Docker build context.

# Database (Aiven PostgreSQL / production)
DB_HOST=<your-database-host>
DB_PORT=17436
DB_USER=<your-database-user>
DB_PASS=<your-database-password>
DB_NAME=<your-database-name>
DB_SSL_MODE=require
# Optional: absolute path to a CA bundle for verify-full TLS
# DB_SSL_ROOTCERT=/etc/ssl/certs/ca-certificates.crt

# Site
SITE_URL=https://<your-site-host>
PLATFORM_NAME=EduPortal LMS

# reCAPTCHA v3
#
# Protects the public auth pages (student and teacher login, both signup
# forms, and the password-reset request) and puts a first-visit human check in
# front of the site. Both halves of the key pair are required; with either one
# missing the whole feature switches itself off and every page behaves exactly
# as it did before.
#
# Obtain the pair from the reCAPTCHA admin console, v3 type. The hostname of
# this site must be registered there, or Google's api.js will refuse to issue
# a token and the portal will appear broken. Register localhost too if you
# develop locally -- including the port, as "localhost:8080" -- or set
# RECAPTCHA_ENABLED=0 on the dev machine instead.
#
# These are DEPLOYMENT settings. .env is gitignored, so filling it in locally
# does not arm the live site -- on Render these go in the service's Environment
# tab, and the service has to be redeployed to pick them up. With either one
# missing the feature switches itself off and serves a normal-looking site
# with no gate, which is easy to mistake for it working. To confirm the live
# site is armed:
#
#   curl -s https://reesnhs.l.cd/ | grep -c human_gate.js    # expect 1
#
# RECAPTCHA_SITE_KEY is public and is rendered into every auth page. The
# secret is not, and must never be committed: this file is gitignored, and
# config/credentials.php is likewise gitignored and excluded from the Docker
# build context. The secret may also be supplied as a define() of the same
# name in config/credentials.php.
RECAPTCHA_SITE_KEY=<your-site-key>
RECAPTCHA_SECRET_KEY=<your-secret-key>
#
# Escape hatch. 0 disables reCAPTCHA entirely -- both the form checks and the
# first-visit gate -- without touching the other settings. Use it to recover
# from a bad key pair or an unregistered hostname without a redeploy.
#RECAPTCHA_ENABLED=1
#
# Behaviour when the siteverify call itself fails (Google unreachable, DNS
# blocked, curl and allow_url_fopen both unavailable). It never applies to a
# token that is missing or that Google rejected: those always fail closed,
# because a bot can trivially omit a token and treating absence as "probably
# fine" would remove the control entirely.
#
#   open   (default) let the request through. A Google outage should not lock
#          a whole school out of its portal.
#   closed refuse the request. Choose this only if the endpoint is reachable
#          from anywhere an attacker could also reach, and a bot that can
#          block your egress to google.com is a concern you are willing to
#          trade a locked-out login page for.
RECAPTCHA_FAIL_MODE=open
#
# Seconds allowed for the siteverify round trip. Deliberately short: this sits
# in front of a login, so a slow call is also the signature of a network that
# cannot reach Google.
#RECAPTCHA_HTTP_TIMEOUT=5
#
# Score floor, 0.0 to 1.0. Google's own guidance is 0.5. A per-action override
# named RECAPTCHA_MIN_SCORE_<ACTION> wins over this, so one noisy action can be
# tuned without weakening the rest -- e.g. RECAPTCHA_MIN_SCORE_SIGNUP=0.4.
# Recognised actions: login, signup, password_reset_request, homepage_gate.
#RECAPTCHA_MIN_SCORE=0.5
#
# Host a token must have been minted on. Defaults to the host of SITE_URL.
# This is not optional in practice: the site key is public, so a token can be
# generated for any action from any site, and the hostname is the only thing
# binding it back to this deployment.
#
# Set it explicitly in production. If SITE_URL is absent the fallback is
# 'http://localhost/Eduportal', and rather than lock every real visitor out
# with a hostname of "localhost" the check steps aside and logs the fact --
# which leaves tokens unbound. Pinning the hostname here removes the
# dependency on SITE_URL entirely.
#RECAPTCHA_EXPECTED_HOSTNAME=<your-site-host>

# Google Analytics 4
#
# The Google tag is emitted into <head> by google_analytics_tag() in
# libs/Analytics.php, which the bootstrap in config/database.php loads. Each
# page that renders a document a human reads calls it; see the note on what is
# deliberately left out below.
#
# GA_MEASUREMENT_ID defaults to this property's id, so the tag works with no
# configuration at all. Override it rather than editing the source if you ever
# want a second property -- a staging id, say. The value is validated against
# the G-XXXXXXXX shape and a value that does not match emits no tag at all,
# because it lands inside a script src and a JS string literal.
#GA_MEASUREMENT_ID=G-JZ0E3M8PPD
#
# 0 to emit nothing. Set this on a development machine, otherwise your own
# page views are recorded in the production property and quietly skew every
# number in it. A separate GA_MEASUREMENT_ID is the better answer if you want
# to see local traffic somewhere.
#GA_ENABLED=1
#
# Not sent, on purpose: a GA user_id, custom dimensions, or anything else that
# would put an LRN or an email address into a system that has none of the
# portal's own access controls, retention policy or deletion path. Role-level
# reporting is available in GA4 without it. Note also that GA4 sets its own
# cookies, so if the school needs a consent banner or a do-not-track
# response, that is a requirement to add here rather than something to work
# around.

# First-visit human check
#
# The splash a brand new browser sees before the site opens. It runs once, then
# the browser is marked as verified.
#
#   enforce  (default) a low score is refused and the visitor sees a retry.
#   observe  a low score is written to auth_events and the visitor is let
#            through anyway. Switch to this the moment a class is being turned
#            away by a shared campus NAT address -- it restores access without
#            a redeploy, and the audit trail still records who scored badly.
#   off      no gate at all.
#
# Note what this control is and is not. It is a friction control: it costs an
# attacker one verified round trip to Google per cold browser, which is what
# makes a scripted signup farm expensive to operate. It is not an access
# control, because anyone can clear or forge a cookie, and with JavaScript
# disabled there is no gate at all. The checks that have to hold are the
# server-side token verifications on the auth forms.
#
# The visitor is marked verified in the session regardless, so the gate is a
# one-time cost rather than a page view. RECAPTCHA_GATE_MIN_SCORE is lower than
# the form threshold on purpose: a false positive here denies the whole portal,
# not just one form.
#RECAPTCHA_GATE_MODE=enforce
#RECAPTCHA_GATE_MIN_SCORE=0.3
#
# Optional. A random string of 40+ characters, e.g.
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Set it to let a verified browser stay verified for 30 days instead of for the
# duration of its session. Without it the gate still works, it just re-asks
# after the browser session ends. The same value may be defined in
# config/credentials.php.
#HUMAN_GATE_SECRET=

# WebAuthn / passkeys
#
# Leave WEBAUTHN_RP_ID unset to derive the Relying Party ID from the host of
# SITE_URL, and leave WEBAUTHN_ORIGINS unset to accept that same origin. Set
# them explicitly only when the portal is served from a host that differs from
# the one SITE_URL advertises.
#
# The Relying Party ID is effectively permanent. A passkey is bound to the RP
# ID that created it, so changing this later silently breaks every enrolled
# credential and every user must re-enrol. Decide before going live.
#
# Origins are compared as exact scheme://host[:port] values. Subdomains are
# NOT accepted. If you add a second host, list it explicitly:
#   WEBAUTHN_ORIGINS=https://portal.school.edu,https://www.school.edu
#WEBAUTHN_RP_ID=<rp-id>
#WEBAUTHN_ORIGINS=https://<your-site-host>

# Legal notices (privacy.php, terms.php, contact.php)
#
# These are the details the School publishes in its Privacy Policy, Terms of
# Service and contact page. Each one is read from the environment by
# libs/legal_page.php and used by all three pages, so a correction is made once.
#
# LEGAL_CONTACT_EMAIL has no default. Until it is set, the pages render without
# a contact address and print a warning banner telling the operator the notice
# is incomplete -- deliberately, because publishing a mailbox that nobody reads
# is a worse failure than an obviously unfinished page. MAIL_FROM is used as a
# fallback, since that is an address the deployment already sends from.
#
# LEGAL_LAST_UPDATED is the date printed at the top of all three pages. Bump it
# whenever any of them changes; they are read as a set, and three different
# revision dates across one policy looks careless.
#
#LEGAL_ENTITY_NAME=Ruben E. Ecleo Sr. National High School
#LEGAL_CONTACT_EMAIL=<address the school reads>
#LEGAL_CONTACT_PHONE=<optional, omitted from the pages when unset>
#LEGAL_ADDRESS=<postal address, required by RA 10173 notices>
#LEGAL_OFFICER_NAME=<person or office that receives data requests>
#LEGAL_LAST_UPDATED=1 September 2026

# Schema migrations
# Leave at 0 in production: controllers report schema readiness instead of
# running ALTER TABLE on request paths. Set to 1 only for local development.
EDUPORTAL_ALLOW_RUNTIME_MIGRATIONS=0

# Object storage (Cloudflare R2 or any S3-compatible endpoint)
# Required for the resumable chunked upload feature.
S3_BUCKET=<your-bucket>
S3_REGION=auto
S3_ENDPOINT=<https://<account-id>.r2.cloudflarestorage.com>
S3_ACCESS_KEY=<your-access-key>
S3_SECRET_KEY=<your-secret-key>
S3_UPLOAD_PREFIX=uploads/
S3_PRESIGNED_URL_EXPIRY=900
S3_USE_PATH_STYLE=false
S3_VERIFY_SSL=true

# The R2 bucket needs a CORS rule that allows PUT from your origin and exposes
# the ETag response header, or chunk uploads cannot read their part ETags.

# Transactional mail (password reset)
#
# Required. Password reset is the only account-recovery path, so without a
# working relay a user who forgets their password is locked out permanently.
#
# Teacher registration approval
#
# Defaults to off, which means a teacher who registers can sign in
# immediately. Leave it unset unless the school runs an administrator who
# activates accounts: with no administrator, approval is a queue nothing
# drains, and every teacher account stays locked out of sign-in forever.
#
# Note that teachers.subject is the authorization key for which submissions
# they can see, so switching this on is only safe if an administrator really
# is reviewing registrations.
#TEACHER_APPROVAL_REQUIRED=1
#
# MAIL_ENABLED=1 is what actually turns sending on. While it is unset, the
# reset request still issues a token but reports that delivery failed, and the
# token is never echoed back into the response -- there is no dev shortcut that
# leaks a working reset link.
#
# Requires the phpmailer/phpmailer Composer dependency (composer install).
MAIL_ENABLED=0
SMTP_HOST=<smtp.your-provider.com>
SMTP_PORT=587
# tls for STARTTLS on 587, ssl for implicit TLS on 465, none for plaintext.
SMTP_ENCRYPTION=tls
SMTP_USER=<smtp-username-or-api-key>
SMTP_PASS=<smtp-password-or-api-secret>
SMTP_FROM=<verified-sender-address>
SMTP_FROM_NAME=EduPortal LMS
